<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/" id="credit_demo-v1" name="Credit evidence checks 1.0" namespace="https://credit-console.local/policies/demo-v1"><description>Illustrative thresholds selected for this demonstration. They are not EBA or Italian legal cutoffs. Passing these checks is not credit approval.</description><inputData id="input_ready" name="ready"><variable name="ready" typeRef="boolean"/></inputData><inputData id="input_cash_available" name="cash_available"><variable name="cash_available" typeRef="number"/></inputData><inputData id="input_existing_principal" name="existing_principal"><variable name="existing_principal" typeRef="number"/></inputData><inputData id="input_existing_interest" name="existing_interest"><variable name="existing_interest" typeRef="number"/></inputData><inputData id="input_new_principal" name="new_principal"><variable name="new_principal" typeRef="number"/></inputData><inputData id="input_new_interest" name="new_interest"><variable name="new_interest" typeRef="number"/></inputData><inputData id="input_debt_after_loan" name="debt_after_loan"><variable name="debt_after_loan" typeRef="number"/></inputData><inputData id="input_ebitda" name="ebitda"><variable name="ebitda" typeRef="number"/></inputData><inputData id="input_secured_exposure" name="secured_exposure"><variable name="secured_exposure" typeRef="number"/></inputData><inputData id="input_collateral_value" name="collateral_value"><variable name="collateral_value" typeRef="number"/></inputData><decision id="service" name="annual_debt_service"><variable name="annual_debt_service" typeRef="number"/><informationRequirement id="ir_service_input_ready"><requiredInput href="#input_ready"/></informationRequirement><informationRequirement id="ir_service_input_existing_principal"><requiredInput href="#input_existing_principal"/></informationRequirement><informationRequirement id="ir_service_input_existing_interest"><requiredInput href="#input_existing_interest"/></informationRequirement><informationRequirement id="ir_service_input_new_principal"><requiredInput href="#input_new_principal"/></informationRequirement><informationRequirement id="ir_service_input_new_interest"><requiredInput href="#input_new_interest"/></informationRequirement><literalExpression id="expr_service"><text>if ready then existing_principal + existing_interest + new_principal + new_interest else null</text></literalExpression></decision><decision id="coverage" name="dscr"><variable name="dscr" typeRef="number"/><informationRequirement id="ir_coverage_input_ready"><requiredInput href="#input_ready"/></informationRequirement><informationRequirement id="ir_coverage_input_cash_available"><requiredInput href="#input_cash_available"/></informationRequirement><informationRequirement id="ir_coverage_service"><requiredDecision href="#service"/></informationRequirement><literalExpression id="expr_coverage"><text>if ready then cash_available / annual_debt_service else null</text></literalExpression></decision><decision id="leverage_metric" name="leverage"><variable name="leverage" typeRef="number"/><informationRequirement id="ir_leverage_metric_input_ready"><requiredInput href="#input_ready"/></informationRequirement><informationRequirement id="ir_leverage_metric_input_debt_after_loan"><requiredInput href="#input_debt_after_loan"/></informationRequirement><informationRequirement id="ir_leverage_metric_input_ebitda"><requiredInput href="#input_ebitda"/></informationRequirement><literalExpression id="expr_leverage_metric"><text>if ready then debt_after_loan / ebitda else null</text></literalExpression></decision><decision id="ltv_metric" name="ltv"><variable name="ltv" typeRef="number"/><informationRequirement id="ir_ltv_metric_input_ready"><requiredInput href="#input_ready"/></informationRequirement><informationRequirement id="ir_ltv_metric_input_secured_exposure"><requiredInput href="#input_secured_exposure"/></informationRequirement><informationRequirement id="ir_ltv_metric_input_collateral_value"><requiredInput href="#input_collateral_value"/></informationRequirement><literalExpression id="expr_ltv_metric"><text>if ready then secured_exposure / collateral_value else null</text></literalExpression></decision><decision id="dscr_test" name="dscr_ok"><variable name="dscr_ok" typeRef="boolean"/><informationRequirement id="ir_dscr_test_input_ready"><requiredInput href="#input_ready"/></informationRequirement><informationRequirement id="ir_dscr_test_coverage"><requiredDecision href="#coverage"/></informationRequirement><literalExpression id="expr_dscr_test"><text>if ready then dscr &gt;= 1.25 else false</text></literalExpression></decision><decision id="leverage_test" name="leverage_ok"><variable name="leverage_ok" typeRef="boolean"/><informationRequirement id="ir_leverage_test_input_ready"><requiredInput href="#input_ready"/></informationRequirement><informationRequirement id="ir_leverage_test_leverage_metric"><requiredDecision href="#leverage_metric"/></informationRequirement><literalExpression id="expr_leverage_test"><text>if ready then leverage &lt;= 3.50 else false</text></literalExpression></decision><decision id="ltv_test" name="ltv_ok"><variable name="ltv_ok" typeRef="boolean"/><informationRequirement id="ir_ltv_test_input_ready"><requiredInput href="#input_ready"/></informationRequirement><informationRequirement id="ir_ltv_test_ltv_metric"><requiredDecision href="#ltv_metric"/></informationRequirement><literalExpression id="expr_ltv_test"><text>if ready then ltv &lt;= 0.80 else false</text></literalExpression></decision><decision id="final" name="outcome"><variable name="outcome" typeRef="string"/><informationRequirement id="final_ready"><requiredInput href="#input_ready"/></informationRequirement><informationRequirement id="final_dscr_test"><requiredDecision href="#dscr_test"/></informationRequirement><informationRequirement id="final_leverage_test"><requiredDecision href="#leverage_test"/></informationRequirement><informationRequirement id="final_ltv_test"><requiredDecision href="#ltv_test"/></informationRequirement><decisionTable id="credit_decision" hitPolicy="UNIQUE"><input id="col_0" label="ready"><inputExpression typeRef="boolean"><text>ready</text></inputExpression></input><input id="col_1" label="dscr_ok"><inputExpression typeRef="boolean"><text>dscr_ok</text></inputExpression></input><input id="col_2" label="leverage_ok"><inputExpression typeRef="boolean"><text>leverage_ok</text></inputExpression></input><input id="col_3" label="ltv_ok"><inputExpression typeRef="boolean"><text>ltv_ok</text></inputExpression></input><output id="outcome_col" typeRef="string"/><rule id="EVIDENCE_GATE"><description>Missing, conflicting, unreviewed or invalid evidence prevents a financial recommendation.</description><inputEntry><text>false</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>"ABSTAIN"</text></outputEntry></rule><rule id="DSCR_FAIL"><description>Compare defined debt-service coverage with the selected demo minimum.</description><inputEntry><text>true</text></inputEntry><inputEntry><text>false</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>"FAIL_POLICY_CHECKS"</text></outputEntry></rule><rule id="LEVERAGE_FAIL"><description>Compare defined leverage with the selected demo maximum.</description><inputEntry><text>true</text></inputEntry><inputEntry><text>true</text></inputEntry><inputEntry><text>false</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>"FAIL_POLICY_CHECKS"</text></outputEntry></rule><rule id="LTV_FAIL"><description>Compare secured exposure with accepted eligible collateral value. Collateral cannot override a failed cash-flow check.</description><inputEntry><text>true</text></inputEntry><inputEntry><text>true</text></inputEntry><inputEntry><text>true</text></inputEntry><inputEntry><text>false</text></inputEntry><outputEntry><text>"FAIL_POLICY_CHECKS"</text></outputEntry></rule><rule id="PASS_CHECKS"><description>All implemented financial checks pass; bank review and approval authority remain required.</description><inputEntry><text>true</text></inputEntry><inputEntry><text>true</text></inputEntry><inputEntry><text>true</text></inputEntry><inputEntry><text>true</text></inputEntry><outputEntry><text>"PASS_POLICY_CHECKS"</text></outputEntry></rule></decisionTable></decision></definitions>